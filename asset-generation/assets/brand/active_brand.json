{
  "brand_name": "Meridian Advisory",
  "industry": "consulting",
  "visual_feel": "premium_minimal",
  "tone": "professional",
  "archetype": "premium_consulting",
  "logo": {
    "enabled": false,
    "path": "",
    "use_text_fallback_when_missing": true
  },
  "colours": {
    "primary": "#2C1F7A",
    "secondary": "#E8A020",
    "text": "#1E1E1E",
    "background": "#FFFFFF",
    "muted": "#7A8A9A",
    "surface": "#F0F5FA"
  },
  "fonts": {
    "heading": "Montserrat",
    "body": "Open Sans"
  },
  "spacing": {
    "page_margin_inches": 1.0,
    "line_spacing": 1.15,
    "paragraph_spacing_pt": 8,
    "section_spacing_pt": 24
  },
  "logo_rules": {
    "docx": {
      "placement": "header-right",
      "width_inches": 1.0
    },
    "pptx": {
      "placement": "top-right",
      "width_inches": 0.8
    },
    "xlsx": {
      "placement": "cover-sheet-top-left",
      "width_inches": 1.1
    },
    "pdf": {
      "placement": "header-right",
      "width_inches": 0.9
    }
  },
  "document_rules": {
    "heading_style": "strong_clean_hierarchy",
    "table_style": "subtle_filled_header",
    "bullet_style": "simple_round",
    "cover_page": true
  },
  "format_defaults": {
    "docx": {
      "use_header_logo": true,
      "default_title_alignment": "left"
    },
    "pptx": {
      "default_layout_family": "clean_corporate",
      "title_alignment": "left"
    },
    "xlsx": {
      "use_cover_sheet": true,
      "freeze_header_rows": true
    },
    "pdf": {
      "include_page_numbers": true
    }
  }
}